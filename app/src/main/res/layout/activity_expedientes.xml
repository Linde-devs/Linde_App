<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expedientes_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F6"
    android:orientation="vertical">

    <TextView
        android:id="@+id/expedientes_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/expedientes_titulo"
        android:textColor="#15524A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/expedientes_progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#15524A" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Lista -->
        <LinearLayout
            android:id="@+id/expedientes_vista_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/expedientes_panel_generar"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/expedientes_texto_generar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#163330"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/expedientes_btn_generar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/expedientes_generar"
                        app:backgroundTint="#2E7D32" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/expedientes_estado_lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/expedientes_btn_reintentar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/expedientes_reintentar"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/expedientes_lista"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Detalle -->
        <ScrollView
            android:id="@+id/expedientes_vista_detalle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/expedientes_sistema"
                    android:textColor="#2F8FB0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/expedientes_det_codigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#15524A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/expedientes_det_fecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#163330"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/expedientes_det_estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/expedientes_det_mensaje_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="10dp"
                    android:textColor="#163330"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/expedientes_btn_descargar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/expedientes_descargar"
                        app:backgroundTint="#15524A" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/expedientes_btn_compartir"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/expedientes_compartir" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/expedientes_seccion_datos"
                    android:textColor="#15524A" />

                <TextView
                    android:id="@+id/expedientes_det_datos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#163330"
                    android:textSize="14sp" />

                <TextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/expedientes_seccion_ubicacion"
                    android:textColor="#15524A" />

                <org.osmdroid.views.MapView
                    android:id="@+id/expedientes_det_mapa"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/expedientes_det_titulo_alertas"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/expedientes_seccion_alertas"
                    android:textColor="#15524A" />

                <LinearLayout
                    android:id="@+id/expedientes_det_alertas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/expedientes_seccion_validaciones"
                    android:textColor="#15524A" />

                <LinearLayout
                    android:id="@+id/expedientes_det_validaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/expedientes_seccion_documentos"
                    android:textColor="#15524A" />

                <LinearLayout
                    android:id="@+id/expedientes_det_documentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/expedientes_det_titulo_inspecciones"
                    style="@style/TextAppearance.Material3.TitleMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/expedientes_seccion_inspecciones"
                    android:textColor="#15524A" />

                <LinearLayout
                    android:id="@+id/expedientes_det_inspecciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/expedientes_det_leyenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#DCEEF5"
                    android:padding="10dp"
                    android:textColor="#163330"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
