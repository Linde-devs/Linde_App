<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/predios_detalle_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/predios_detalle_barra"
        style="@style/Linde.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/predios_detalle_progreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/predios_detalle_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/linde_error_fondo"
                android:padding="12dp"
                android:textColor="@color/linde_error"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_reintentar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/comun_reintentar"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/predios_detalle_contenido"
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/predios_detalle_nombre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/linde_primario"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/predios_detalle_estado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/fondo_estado"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/predios_detalle_datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/linde_texto"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/predios_form_seccion_titulo"
                        android:textColor="@color/linde_primario"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/predios_detalle_titulo_inra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/linde_texto"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/predios_detalle_poligono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@color/linde_info_fondo"
                        android:padding="8dp"
                        android:textColor="@color/linde_texto"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Los siete accesos, en este orden. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_poligono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/predios_detalle_poligono_btn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_documentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predios_detalle_documentos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_envio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predios_detalle_envio"
                app:backgroundTint="@color/linde_accion" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_alertas"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predios_detalle_alertas" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_inspecciones"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predios_detalle_inspecciones" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_expedientes"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predios_detalle_expedientes" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/predios_detalle_btn_editar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predios_detalle_editar" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
